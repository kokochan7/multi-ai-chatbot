<UserControl x:Class="MultiAIChatbot.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One item the AIs agree on: its picture, name, how many AIs agree, and what each said -->
        <DataTemplate x:Key="ItemTemplate">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Picture, with a placeholder (the item's first letter) until one is found -->
                    <Grid Width="104" Height="104" VerticalAlignment="Top" Margin="0,0,16,0">
                        <Border CornerRadius="12" Background="{Binding PlaceholderBrush}">
                            <TextBlock Text="{Binding Initial}" FontSize="38" FontWeight="SemiBold" Foreground="White"
                                       Opacity="0.95" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="12" Background="White" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                            <Border CornerRadius="11" Margin="4">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Image}" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,3" VerticalAlignment="Top"
                                    Background="{Binding BadgeFill}" Margin="10,1,0,0">
                                <TextBlock Text="{Binding BadgeText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding BadgeForeground}"/>
                            </Border>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run Text="{Binding Rank, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"
                                     FontSize="13" FontWeight="SemiBold"/><Run Text="  "/><Run
                                     Text="{Binding Name, Mode=OneWay}" FontSize="16.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimary}"/>
                            </TextBlock>
                        </DockPanel>

                        <!-- Which AIs recommended it -->
                        <ItemsControl ItemsSource="{Binding Pills}" Margin="0,7,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Opacity="{Binding Opacity}"
                                                ToolTip="{Binding Tip}">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"
                                                 Margin="0,1,6,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                   TextDecorations="{Binding Decorations}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- What each AI said about it -->
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding Color}" BorderThickness="2.5,0,0,0" Padding="9,1,0,1"
                                            Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" MaxHeight="54"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}"
                                                   ToolTip="{Binding Tip}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource QuietLinkButton}" Content="Search the web" HorizontalAlignment="Left"
                                FontSize="12" Margin="0,2,0,0" Tag="{Binding Name}" Click="Search_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A count tile at the top of the page -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="24,20">
        <Grid>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="30"
                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource TextMuted}" FontSize="14"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Text="Ask a question on the Chat page, for example &quot;best face cleanser for dry skin&quot;, and this page shows what the AIs agree on."/>
            </StackPanel>

            <DockPanel x:Name="ResultPanel" Visibility="Collapsed">
                <!-- Which question is being compared, and how much the AIs agree -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="WHAT THE AIs AGREE ON" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="QuestionText" FontFamily="{StaticResource DisplayFont}" FontSize="21"
                               FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SummaryText" FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <WrapPanel x:Name="StatsPanel" Margin="0,14,0,0">
                        <Border x:Name="AllTile" Style="{StaticResource StatTile}" Background="#2622A55B">
                            <StackPanel>
                                <TextBlock x:Name="AllCount" FontSize="24" FontWeight="SemiBold" Foreground="#22A55B"/>
                                <TextBlock x:Name="AllCaption" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SomeTile" Style="{StaticResource StatTile}" Background="#26E0A030">
                            <StackPanel>
                                <TextBlock x:Name="SomeCount" FontSize="24" FontWeight="SemiBold" Foreground="#D08A12"/>
                                <TextBlock Text="items 2 of 3 agree on" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,8">
                        <StackPanel x:Name="AllHeaderPanel" Orientation="Horizontal" Margin="0,2,0,10">
                            <Ellipse Width="9" Height="9" Fill="#22A55B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AllHeader" Style="{StaticResource SectionLabel}" FontSize="12"/>
                        </StackPanel>
                        <ItemsControl x:Name="AllList" ItemTemplate="{StaticResource ItemTemplate}"/>

                        <StackPanel x:Name="SomeHeaderPanel" Orientation="Horizontal" Margin="0,14,0,10">
                            <Ellipse Width="9" Height="9" Fill="#E0A030" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SomeHeader" Style="{StaticResource SectionLabel}" FontSize="12"/>
                        </StackPanel>
                        <ItemsControl x:Name="SomeList" ItemTemplate="{StaticResource ItemTemplate}"/>

                        <TextBlock x:Name="NoMatchText" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,4,0,10" Visibility="Collapsed"/>
                        <TextBlock x:Name="ImageNote" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,8,0,0" Opacity="0.8"
                                   Text="Pictures are found with a Bing image search for each item's name, so one may not be the exact product."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
