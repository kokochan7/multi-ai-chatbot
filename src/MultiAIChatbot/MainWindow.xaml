<Window x:Class="MultiAIChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MultiAIChatbot.Views"
        Title="Multi-AI Chatbot" Width="1500" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left menu -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,18" Orientation="Horizontal">
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Multi-AI Chat" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <RadioButton DockPanel.Dock="Bottom" x:Name="NavSettings" GroupName="Nav"
                             Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                             Checked="Nav_Checked"/>

                <StackPanel>
                    <RadioButton x:Name="NavChat" GroupName="Nav" Style="{StaticResource NavButton}"
                                 Tag="&#xE8F2;" Content="Chat" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavButton}"
                                 Tag="&#xE81C;" Content="History" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages. All stay loaded so the AI sites keep their state when you switch pages. -->
        <Grid Grid.Column="2">
            <v:ChatView x:Name="ChatPage"/>
            <v:HistoryView x:Name="HistoryPage" Visibility="Collapsed"/>
            <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
