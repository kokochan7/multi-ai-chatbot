<UserControl x:Class="MultiAIChatbot.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MultiAIChatbot.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- AI columns side by side. Order and visibility come from Settings. -->
        <Grid Grid.Row="0" x:Name="ColumnsGrid">

            <c:AiPane x:Name="ChatGptPane" SiteKey="chatgpt" Title="ChatGPT" Badge="G" Accent="#10A37F"
                      HomeUrl="https://chatgpt.com/"/>
            <c:AiPane x:Name="ClaudePane" SiteKey="claude" Title="Claude" Badge="C" Accent="#D97757"
                      HomeUrl="https://claude.ai/new"/>
            <c:AiPane x:Name="GeminiPane" SiteKey="gemini" Title="Gemini" Badge="G" Accent="#4285F4"
                      HomeUrl="https://gemini.google.com/app"/>
        </Grid>

        <!-- Shared prompt box: one question goes to all three sites -->
        <Grid Grid.Row="1" Margin="0,14,0,0" MaxWidth="1100">
            <!-- Soft shadow drawn behind the bar (kept separate so the text stays sharp) -->
            <Border CornerRadius="18" Background="{DynamicResource CardBackground}" Margin="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.10"
                                      Color="{StaticResource ShadowColor}"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="18" Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="10,8">
                <DockPanel>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Width="40" Height="40"
                            ToolTip="Send to all (Enter)" Cursor="Hand" Click="Send_Click" VerticalAlignment="Bottom">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Accent}" CornerRadius="12">
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{DynamicResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE710;"
                            Width="40" Height="40" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Bottom"
                            ToolTip="New chat on all sites" Click="NewChat_Click"/>
                    <Grid Margin="4,0,12,0">
                        <TextBox x:Name="PromptBox" BorderThickness="0" Background="Transparent" Padding="0"
                                 FontSize="15" VerticalContentAlignment="Center" MinHeight="40" MaxHeight="180"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="PromptBox_PreviewKeyDown" TextChanged="PromptBox_TextChanged"/>
                        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="2,0,0,0"
                                   Text="Ask all your AIs at once…   Enter to send · Shift+Enter for a new line"
                                   FontSize="15" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
