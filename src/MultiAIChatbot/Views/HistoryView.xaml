<UserControl x:Class="MultiAIChatbot.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MultiAIChatbot.Services">
    <UserControl.Resources>
        <!-- Read-only, selectable answer text -->
        <Style x:Key="AnswerBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- A saved answer, shown as formatted text (headings, lists, links, code) -->
        <Style x:Key="AnswerDoc" TargetType="RichTextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsDocumentEnabled" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- One answer column inside the detail view -->
        <Style x:Key="AnswerCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12,8,14"/>
        </Style>
    </UserControl.Resources>

    <!-- One chat from the Recent list: every question asked in it, each with its answers side by side -->
    <Border Style="{StaticResource Card}" Padding="24,20">
        <Grid>
            <StackPanel x:Name="NoSelectionText" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="30"
                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Pick a chat under Recent in the left menu to compare its answers."
                           Foreground="{DynamicResource TextMuted}" FontSize="14"/>
            </StackPanel>
            <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                <!-- Chat header -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Click="Delete_Click"
                            VerticalAlignment="Top" ToolTip="Delete this chat and all its answers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Delete chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}">
                            <Run Text="{Binding TimeText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding CountText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="19"
                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Every question in the chat, oldest first -->
                <ScrollViewer x:Name="TurnsScroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,8,22">
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietLinkButton}" FontSize="12"
                                                Content="Ask again" Click="AskAgain_Click" VerticalAlignment="Top"
                                                ToolTip="Put this question back in the prompt box"/>
                                        <TextBlock Text="&#xE8F2;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Top"
                                                   Margin="0,3,10,0"/>
                                        <TextBox Text="{Binding Prompt, Mode=OneWay}" Style="{StaticResource AnswerBox}"
                                                 FontSize="15" FontWeight="SemiBold" MaxHeight="120"/>
                                    </DockPanel>
                                    <Grid MaxHeight="460">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource AnswerCard}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                                        ToolTip="Copy answer" Tag="chatgpt" Click="Copy_Click"/>
                                                <Ellipse Width="8" Height="8" Fill="#10A37F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="ChatGPT" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <RichTextBox Style="{StaticResource AnswerDoc}" s:MarkdownRenderer.Markdown="{Binding ChatGpt}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource AnswerCard}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                                        ToolTip="Copy answer" Tag="claude" Click="Copy_Click"/>
                                                <Ellipse Width="8" Height="8" Fill="#D97757" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Claude" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <RichTextBox Style="{StaticResource AnswerDoc}" s:MarkdownRenderer.Markdown="{Binding Claude}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource AnswerCard}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                                        ToolTip="Copy answer" Tag="gemini" Click="Copy_Click"/>
                                                <Ellipse Width="8" Height="8" Fill="#4285F4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Gemini" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <RichTextBox Style="{StaticResource AnswerDoc}" s:MarkdownRenderer.Markdown="{Binding Gemini}"/>
                                        </DockPanel>
                                    </Border>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
