<UserControl x:Class="MultiAIChatbot.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Read-only, selectable answer text -->
        <Style x:Key="AnswerBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- List of past questions -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Clear all"
                            Click="ClearAll_Click"/>
                    <TextBlock Text="History" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="0,0,0,10" Padding="6,5"
                         FontFamily="{StaticResource UiFont}" FontSize="13" TextChanged="SearchBox_TextChanged"
                         ToolTip="Search your past questions and answers"/>
                <Grid>
                    <ListBox x:Name="EntryList" BorderThickness="0" SelectionChanged="EntryList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,6">
                                    <TextBlock Text="{Binding Prompt}" FontSize="14" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" MaxHeight="40"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TimeText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="No questions yet. Ask something on the Chat page."
                               TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13"
                               Margin="4,8" VerticalAlignment="Top"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- The selected question with its three answers -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <TextBlock x:Name="NoSelectionText" Text="Pick a question on the left to see its answers."
                           Foreground="{StaticResource TextMuted}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource SmallButton}" Content="Ask again" Click="AskAgain_Click"
                                    ToolTip="Put this question back in the prompt box"/>
                            <Button Style="{StaticResource SmallButton}" Content="Delete" Click="Delete_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <TextBox Text="{Binding Prompt, Mode=OneWay}" Style="{StaticResource AnswerBox}"
                                     FontSize="17" FontWeight="SemiBold" MaxHeight="120" Padding="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                        ToolTip="Copy answer" Tag="chatgpt" Click="Copy_Click"/>
                                <TextBlock Text="ChatGPT" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Style="{StaticResource AnswerBox}" Text="{Binding ChatGpt, Mode=OneWay}"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                        ToolTip="Copy answer" Tag="claude" Click="Copy_Click"/>
                                <TextBlock Text="Claude" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Style="{StaticResource AnswerBox}" Text="{Binding Claude, Mode=OneWay}"/>
                        </DockPanel>
                        <DockPanel Grid.Column="4">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                        ToolTip="Copy answer" Tag="gemini" Click="Copy_Click"/>
                                <TextBlock Text="Gemini" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Style="{StaticResource AnswerBox}" Text="{Binding Gemini, Mode=OneWay}"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
