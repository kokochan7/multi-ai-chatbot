<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MultiAIChatbot</AssemblyName>
    <RootNamespace>MultiAIChatbot</RootNamespace>
    <Product>Multi-AI Chatbot</Product>
    <Version>0.1.0</Version>
    <!-- Lets the project be restored/built from non-Windows machines (CI uses Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Icon shown for the .exe in Explorer and the taskbar -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <EmbeddedResource Include="Scripts\*.js" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
