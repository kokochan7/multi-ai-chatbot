<UserControl x:Class="MultiAIChatbot.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One item the AIs recommended, with a pill per AI (filled when that AI mentioned it) -->
        <DataTemplate x:Key="ItemTemplate">
            <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="10" Padding="14,10,14,10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Pills}" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,2" Margin="6,0,0,0" Background="{Binding Fill}"
                                            BorderBrush="{Binding Stroke}" BorderThickness="1" ToolTip="{Binding Tip}">
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{Binding TextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,12,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- What each AI said about it -->
                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextMuted}">
                                    <Run Text="{Binding Site, Mode=OneWay}" Foreground="{Binding Color, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="24,20">
        <Grid>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="30"
                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource TextMuted}" FontSize="14"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Text="Ask a question on the Chat page, for example &quot;best face cleanser for dry skin&quot;, and this page shows what the AIs agree on."/>
            </StackPanel>

            <DockPanel x:Name="ResultPanel" Visibility="Collapsed">
                <!-- Which question is being compared -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="WHAT THE AIs AGREE ON" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="QuestionText" FontFamily="{StaticResource DisplayFont}" FontSize="19"
                               FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Name="SummaryText" FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock x:Name="AllHeader" Style="{StaticResource SectionLabel}" Margin="0,4,0,8"/>
                        <ItemsControl x:Name="AllList" ItemTemplate="{StaticResource ItemTemplate}"/>
                        <TextBlock x:Name="SomeHeader" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"/>
                        <ItemsControl x:Name="SomeList" ItemTemplate="{StaticResource ItemTemplate}"/>
                        <TextBlock x:Name="NoMatchText" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,4,0,10" Visibility="Collapsed"/>
                        <Button x:Name="OneToggle" Style="{StaticResource QuietLinkButton}" HorizontalAlignment="Left"
                                Margin="0,14,0,8" Click="OneToggle_Click"/>
                        <ItemsControl x:Name="OneList" ItemTemplate="{StaticResource ItemTemplate}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
