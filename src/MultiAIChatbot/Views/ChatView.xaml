<UserControl x:Class="MultiAIChatbot.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MultiAIChatbot.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search all AIs at once (Ctrl+F). Matches are highlighted inside every column. -->
        <Border x:Name="FindBar" Grid.Row="0" Visibility="Collapsed" HorizontalAlignment="Center"
                MinWidth="560" MaxWidth="1000" Margin="0,0,0,6" CornerRadius="12" Padding="10,4,6,4"
                Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Width="28" Height="28" FontSize="11"
                            ToolTip="Previous match (Shift+Enter)" Click="FindPrevious_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Width="28" Height="28" FontSize="11"
                            ToolTip="Next match (Enter)" Click="FindNext_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28" FontSize="10"
                            ToolTip="Close (Esc)" Click="FindClose_Click"/>
                </StackPanel>
                <!-- Match count for each AI, e.g. "ChatGPT 2/7" -->
                <StackPanel x:Name="FindCounts" DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,6,0"/>
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid VerticalAlignment="Center" MinWidth="180">
                    <TextBox x:Name="FindBox" BorderThickness="0" Background="Transparent" Padding="0"
                             FontSize="14" VerticalContentAlignment="Center" MinHeight="28"
                             TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown"/>
                    <TextBlock x:Name="FindPlaceholder" IsHitTestVisible="False" Margin="2,0,0,0"
                               Text="Search all AIs…" FontSize="14" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- AI columns side by side. Order and visibility come from Settings. -->
        <Grid Grid.Row="1" x:Name="ColumnsGrid">

            <c:AiPane x:Name="ChatGptPane" SiteKey="chatgpt" Title="ChatGPT" Badge="G" Accent="#10A37F"
                      HomeUrl="https://chatgpt.com/"/>
            <c:AiPane x:Name="ClaudePane" SiteKey="claude" Title="Claude" Badge="C" Accent="#D97757"
                      HomeUrl="https://claude.ai/new"/>
            <c:AiPane x:Name="GeminiPane" SiteKey="gemini" Title="Gemini" Badge="G" Accent="#4285F4"
                      HomeUrl="https://gemini.google.com/app"/>
        </Grid>

        <!-- Shared prompt box: one question (plus any attached files) goes to all three sites.
             Drop files anywhere on it, or use the paperclip. -->
        <Grid Grid.Row="2" Margin="0,6,0,0" MaxWidth="1100" AllowDrop="True"
              PreviewDragEnter="PromptBar_PreviewDragOver" PreviewDragOver="PromptBar_PreviewDragOver"
              PreviewDragLeave="PromptBar_PreviewDragLeave" PreviewDrop="PromptBar_PreviewDrop">
            <!-- Soft shadow drawn behind the bar (kept separate so the text stays sharp) -->
            <Border CornerRadius="18" Background="{DynamicResource CardBackground}" Margin="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.10"
                                      Color="{StaticResource ShadowColor}"/>
                </Border.Effect>
            </Border>
            <Border x:Name="PromptBarBorder" CornerRadius="18" Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="10,8">
                <DockPanel>
                    <!-- Attached files, shown as chips above the text -->
                    <ItemsControl x:Name="AttachmentList" DockPanel.Dock="Top" Margin="2,0,0,6" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Chip" Background="{DynamicResource AccentSoft}" CornerRadius="9"
                                        Padding="10,4,4,4" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Pictures show a small preview (hover for a bigger one) -->
                                        <Border x:Name="Thumb" Width="44" Height="44" CornerRadius="6" Margin="0,0,9,0"
                                                Visibility="Collapsed" ToolTipService.InitialShowDelay="250">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                            <Border.ToolTip>
                                                <Image Source="{Binding Preview}" MaxWidth="360" MaxHeight="360"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border.ToolTip>
                                        </Border>
                                        <TextBlock x:Name="FileIcon" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" MaxWidth="220"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding SizeText}" FontSize="11" Margin="6,0,2,0"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="22" Height="22"
                                                FontSize="9" ToolTip="Remove" Tag="{Binding}" Click="RemoveAttachment_Click"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                        <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="FileIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Chip" Property="Padding" Value="4,4,4,4"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="SendButton" DockPanel.Dock="Right" Width="40" Height="40"
                            ToolTip="Send to all (Enter)" Cursor="Hand" Click="Send_Click" VerticalAlignment="Bottom">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Accent}" CornerRadius="12">
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{DynamicResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Shrinks the box back to one line (shown only when it has grown) -->
                    <Button x:Name="ShrinkButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE73F;" Width="34" Height="34" Margin="0,0,6,3" VerticalAlignment="Bottom"
                            ToolTip="Shrink the chat box back to normal size (removes blank lines)"
                            Click="Shrink_Click" Visibility="Collapsed"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE721;"
                            Width="34" Height="40" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Bottom"
                            ToolTip="Search all AI answers (Ctrl+F)" Click="OpenFind_Click"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE723;"
                            Width="36" Height="40" FontSize="15" VerticalAlignment="Bottom"
                            ToolTip="Attach files or images (or drop them here)" Click="Attach_Click"/>
                    <Grid Margin="6,0,12,0">
                        <TextBox x:Name="PromptBox" BorderThickness="0" Background="Transparent" Padding="0"
                                 FontSize="15" VerticalContentAlignment="Center" MinHeight="40" MaxHeight="180"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="PromptBox_PreviewKeyDown" TextChanged="PromptBox_TextChanged"
                                 SizeChanged="PromptBox_SizeChanged"/>
                        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="2,0,0,0"
                                   Text="Ask all your AIs at once…   Enter to send · Shift+Enter for a new line · drop files here"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="15" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
