<UserControl x:Class="MultiAIChatbot.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Read-only, selectable answer text -->
        <Style x:Key="AnswerBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- One answer column inside the detail view -->
        <Style x:Key="AnswerCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10,8,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- List of past questions -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,18,14,14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Clear all"
                            Padding="10,5" FontSize="12" Click="ClearAll_Click"/>
                    <TextBlock Text="History" Style="{StaticResource PageTitle}" FontSize="20" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Search -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" Padding="32,8,8,8" TextChanged="SearchBox_TextChanged"
                             ToolTip="Search your past questions and answers"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="Search questions and answers" FontSize="13"
                               Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="33,0,0,0"/>
                </Grid>

                <Grid>
                    <ListBox x:Name="EntryList" SelectionChanged="EntryList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6">
                                    <TextBlock Text="{Binding Prompt}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}" MaxHeight="38"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TimeText}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyText" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="No questions yet" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ask something on the Chat page and it shows up here."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMuted}"
                                   FontSize="12.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- The selected question with its answers -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20">
            <Grid>
                <StackPanel x:Name="NoSelectionText" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="30"
                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Pick a question on the left to compare its answers."
                               Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                </StackPanel>
                <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource PrimaryButton}" Click="AskAgain_Click" Margin="0,0,8,0"
                                    ToolTip="Put this question back in the prompt box">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ask again" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Click="Delete_Click" ToolTip="Delete this question">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            <TextBox Text="{Binding Prompt, Mode=OneWay}" Style="{StaticResource AnswerBox}"
                                     FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                     MaxHeight="120" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource AnswerCard}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                            ToolTip="Copy answer" Tag="chatgpt" Click="Copy_Click"/>
                                    <Ellipse Width="8" Height="8" Fill="#10A37F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="ChatGPT" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox Style="{StaticResource AnswerBox}" Text="{Binding ChatGpt, Mode=OneWay}"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource AnswerCard}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                            ToolTip="Copy answer" Tag="claude" Click="Copy_Click"/>
                                    <Ellipse Width="8" Height="8" Fill="#D97757" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Claude" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox Style="{StaticResource AnswerBox}" Text="{Binding Claude, Mode=OneWay}"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource AnswerCard}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                            ToolTip="Copy answer" Tag="gemini" Click="Copy_Click"/>
                                    <Ellipse Width="8" Height="8" Fill="#4285F4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Gemini" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox Style="{StaticResource AnswerBox}" Text="{Binding Gemini, Mode=OneWay}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
