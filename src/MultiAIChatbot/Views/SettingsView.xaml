<UserControl x:Class="MultiAIChatbot.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="28">
        <StackPanel>
            <TextBlock Text="Settings" FontFamily="{StaticResource UiFont}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Show or hide each AI, reorder the columns, and log out will live here."
                       Margin="0,8,0,24" FontFamily="{StaticResource UiFont}" FontSize="14"
                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>

            <TextBlock Text="Saved logins" FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="DataFolderText" Margin="0,6,0,0" FontFamily="{StaticResource UiFont}" FontSize="13"
                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
