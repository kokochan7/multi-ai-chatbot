<UserControl x:Class="MultiAIChatbot.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A group of related settings -->
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="28,0,0,14"/>
        </Style>

        <!-- Segmented picker (System / Light / Dark) -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="14,6" Margin="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="4,4,16,4">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,4,0,18"/>

            <!-- Appearance -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeader}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="Appearance" Style="{StaticResource Heading}"/>
                    </StackPanel>
                    <TextBlock Text="Choose a light or dark look, or follow your Windows setting. The AI sites follow it too."
                               Style="{StaticResource Hint}"/>
                    <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1" CornerRadius="9" HorizontalAlignment="Left" Margin="28,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource Segment}"
                                         Tag="&#xE7F4;" Content="System" Checked="Theme_Checked"/>
                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource Segment}"
                                         Tag="&#xE706;" Content="Light" Checked="Theme_Checked"/>
                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource Segment}"
                                         Tag="&#xE708;" Content="Dark" Checked="Theme_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Columns -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeader}">
                        <TextBlock Text="&#xE8A9;" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="Columns" Style="{StaticResource Heading}"/>
                    </StackPanel>
                    <TextBlock Text="Tick the AIs to show, and use the arrows to change their order. On the Chat page you can also drag a column by its header to move it, and drag the gaps between columns to resize them."
                               Style="{StaticResource Hint}"/>
                    <ItemsControl x:Name="ColumnList" Margin="28,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource Divider}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,6,6,6" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move left"
                                                    Tag="{Binding Key}" Click="MoveUp_Click"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move right"
                                                    Tag="{Binding Key}" Click="MoveDown_Click"/>
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding Shown, Mode=OneWay}" Tag="{Binding Key}"
                                                  Content="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                                  Click="Shown_Click"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- History -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeader}">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="History" Style="{StaticResource Heading}"/>
                    </StackPanel>
                    <TextBlock Text="Every question you ask is saved on this PC so you can find it again."
                               Style="{StaticResource Hint}"/>
                    <CheckBox x:Name="SaveAnswersBox" Style="{StaticResource ToggleSwitch}"
                              Content="Save each AI's answer along with my question"
                              FontSize="14" Margin="28,0,0,14" Checked="SaveAnswers_Changed" Unchecked="SaveAnswers_Changed"/>
                    <Button Style="{StaticResource DangerButton}" Content="Clear history" HorizontalAlignment="Left"
                            Margin="28,0,0,0" Click="ClearHistory_Click"/>
                </StackPanel>
            </Border>

            <!-- Logins -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeader}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="Logins and privacy" Style="{StaticResource Heading}"/>
                    </StackPanel>
                    <TextBlock x:Name="DataFolderText" Style="{StaticResource Hint}"/>
                    <Button Style="{StaticResource DangerButton}" Content="Log out of all sites" HorizontalAlignment="Left"
                            Margin="28,0,0,0" Click="LogOut_Click"/>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeader}">
                        <TextBlock Text="&#xE895;" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="Updates" Style="{StaticResource Heading}"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}"/>
                    <CheckBox x:Name="AutoCheckBox" Style="{StaticResource ToggleSwitch}"
                              Content="Check for updates when the app starts"
                              FontSize="14" Margin="28,0,0,14" Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Check for updates"
                            HorizontalAlignment="Left" Margin="28,0,0,0" Click="Update_Click"/>
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="28,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="4,0,0,12"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
