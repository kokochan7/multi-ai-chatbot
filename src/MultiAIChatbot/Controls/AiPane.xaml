<UserControl x:Class="MultiAIChatbot.Controls.AiPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Column header: badge, name, and browser buttons -->
            <Border Grid.Row="0" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                    Margin="14,0" Padding="0,10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                                ToolTip="Back" Click="Back_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                ToolTip="Reload" Click="Reload_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE80F;"
                                ToolTip="Go to start page" Click="Home_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;"
                                ToolTip="Open this page in your web browser" Click="OpenExternal_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Badge" Width="22" Height="22" CornerRadius="5" Margin="0,0,9,0">
                            <TextBlock x:Name="BadgeText" Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText" FontFamily="{StaticResource UiFont}" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The website itself -->
            <Grid Grid.Row="1" Margin="4,4,4,6">
                <TextBlock x:Name="StatusText" Text="Loading…" Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource UiFont}" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                <wv2:WebView2 x:Name="Browser" Visibility="Hidden"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
