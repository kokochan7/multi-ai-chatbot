<UserControl x:Class="MultiAIChatbot.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="28">
        <StackPanel>
            <TextBlock Text="History" FontFamily="{StaticResource UiFont}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Your past questions and answers will show up here." Margin="0,8,0,0"
                       FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
    </Border>
</UserControl>
