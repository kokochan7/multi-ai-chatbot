<UserControl x:Class="MultiAIChatbot.Controls.AiPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Column header: badge, name, status and browser buttons -->
            <!-- Click and hold here, then drag sideways, to move this column -->
            <Border x:Name="HeaderBar" Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                    Background="Transparent" CornerRadius="13,13,0,0" Padding="14,10,10,10" Cursor="SizeAll"
                    ToolTip="Drag to move this column"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp" LostMouseCapture="Header_LostMouseCapture">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                                ToolTip="Back" Click="Back_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                ToolTip="Reload" Click="Reload_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE80F;"
                                ToolTip="Go to start page" Click="Home_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;"
                                ToolTip="Open this page in your web browser" Click="OpenExternal_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeBorder" Width="26" Height="26" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock x:Name="BadgeText" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <!-- Status pill: "Sending…", "Sent", or what went wrong -->
                        <Border x:Name="StatusPill" CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                                Background="{DynamicResource NavHover}" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="SendStatus" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The website itself -->
            <Grid Grid.Row="1" Margin="1,0,1,1">
                <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StatusText" Text="Loading…" Foreground="{DynamicResource TextMuted}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
                <wv2:WebView2 x:Name="Browser" Visibility="Hidden"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
