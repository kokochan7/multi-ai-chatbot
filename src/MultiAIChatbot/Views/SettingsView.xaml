<UserControl x:Class="MultiAIChatbot.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,24,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="28">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Settings" FontFamily="{StaticResource UiFont}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>

                <TextBlock Text="Columns" Style="{StaticResource Heading}"/>
                <TextBlock Text="Tick the AIs to show, and use the arrows to change their order from left to right."
                           Style="{StaticResource Hint}"/>
                <ItemsControl x:Name="ColumnList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"
                                    Padding="12,6" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move left"
                                                Tag="{Binding Key}" Click="MoveUp_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move right"
                                                Tag="{Binding Key}" Click="MoveDown_Click"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding Shown, Mode=OneWay}" Tag="{Binding Key}"
                                              Content="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Click="Shown_Click"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="History" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="SaveAnswersBox" Content="Save each AI's answer along with my question"
                          FontSize="14" Margin="0,4,0,10" Checked="SaveAnswers_Changed" Unchecked="SaveAnswers_Changed"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="Clear history" Click="ClearHistory_Click"/>
                </StackPanel>

                <TextBlock Text="Logins" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="DataFolderText" Style="{StaticResource Hint}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="Log out of all sites" Click="LogOut_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
