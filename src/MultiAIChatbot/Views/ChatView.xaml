<UserControl x:Class="MultiAIChatbot.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MultiAIChatbot.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- AI columns side by side. Order and visibility come from Settings. -->
        <Grid Grid.Row="0" x:Name="ColumnsGrid">

            <c:AiPane x:Name="ChatGptPane" SiteKey="chatgpt" Title="ChatGPT" Badge="G" Accent="#10A37F"
                      HomeUrl="https://chatgpt.com/"/>
            <c:AiPane x:Name="ClaudePane" SiteKey="claude" Title="Claude" Badge="C" Accent="#D97757"
                      HomeUrl="https://claude.ai/new"/>
            <c:AiPane x:Name="GeminiPane" SiteKey="gemini" Title="Gemini" Badge="G" Accent="#4285F4"
                      HomeUrl="https://gemini.google.com/app"/>
        </Grid>

        <!-- Shared prompt box: one question goes to all three sites -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <DockPanel>
                <Button x:Name="SendButton" DockPanel.Dock="Right" Width="38" Height="38"
                        ToolTip="Send to all three (Enter)" Cursor="Hand" Click="Send_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{StaticResource Accent}" CornerRadius="19">
                                <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE710;"
                        Width="38" Height="38" FontSize="16" Margin="0,0,8,0"
                        ToolTip="New chat on all three sites" Click="NewChat_Click"/>
                <Grid Margin="0,0,12,0">
                    <TextBox x:Name="PromptBox" BorderThickness="0" FontFamily="{StaticResource UiFont}" FontSize="15"
                             VerticalContentAlignment="Center" MinHeight="38" MaxHeight="160"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="PromptBox_PreviewKeyDown" TextChanged="PromptBox_TextChanged"/>
                    <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="3,0,0,0"
                               Text="Ask all three AIs… (Enter to send, Shift+Enter for a new line)"
                               FontFamily="{StaticResource UiFont}" FontSize="15"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
