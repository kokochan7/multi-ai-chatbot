<Window x:Class="MultiAIChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MultiAIChatbot.Views"
        xmlns:local="clr-namespace:MultiAIChatbot"
        Title="Multi-AI Chatbot" Width="1500" Height="900" MinWidth="960" MinHeight="600"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="180" MaxWidth="460"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left menu -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" Padding="14,20,14,16">
            <DockPanel>
                <!-- Logo and app name -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,28">
                    <Image Source="Assets/logo.png" Width="36" Height="36"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Multi-AI Chat" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="One question, every AI" FontSize="11.5"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: settings and version -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Shown when a newer version has been published while the app is open -->
                    <Button x:Name="UpdateBanner" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                            Margin="4,0,4,12" Padding="10,7" Visibility="Collapsed" Click="UpdateBanner_Click"
                            ToolTip="Download the new version and restart the app">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="UpdateBannerText" Text="Update available" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="4,0,4,10"/>
                    <RadioButton x:Name="NavSettings" GroupName="Nav"
                                 Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 Checked="Nav_Checked"/>
                    <DockPanel Margin="12,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Reset view" Style="{StaticResource QuietLinkButton}"
                                ToolTip="Put the menu width, column sizes and order, and chat box back to how they started"
                                Click="ResetView_Click"/>
                        <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <!-- Start a fresh chat on every AI site -->
                <Button DockPanel.Dock="Top" x:Name="NewChatButton" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Padding="12,9" Margin="4,0,4,20"
                        ToolTip="Start a new chat on all AI sites" Click="NewChat_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="New Chat" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MENU" Style="{StaticResource SectionLabel}" Margin="12,0,0,8"/>
                    <RadioButton x:Name="NavChat" GroupName="Nav" Style="{StaticResource NavButton}"
                                 Tag="&#xE8F2;" Content="Chat" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavButton}"
                                 Tag="&#xE81C;" Content="History" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavCompare" GroupName="Nav" Style="{StaticResource NavButton}"
                                 Tag="&#xE9D5;" Content="Compare" Checked="Nav_Checked"
                                 ToolTip="See which items the AIs agree on. Pick a chat under Recent to compare it."/>
                    <DockPanel Margin="12,22,4,8">
                        <Button DockPanel.Dock="Right" x:Name="ClearAllButton" Content="Clear all"
                                Style="{StaticResource LinkButton}" Click="ClearAll_Click"
                                ToolTip="Delete all saved questions and answers"/>
                        <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- Search past questions and answers -->
                    <Grid x:Name="SearchPanel" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Padding="8,6,28,6" FontSize="12.5" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,11,0"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Search" FontSize="12.5"
                                   Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Recent questions. Clicking one opens it in History with all its answers. -->
                <Grid Margin="0,0,0,10">
                    <ListBox x:Name="RecentList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="RecentList_Click" KeyDown="RecentList_KeyDown"
                             PreviewKeyDown="RecentList_PreviewKeyDown" LostKeyboardFocus="RecentList_LostKeyboardFocus">
                        <ListBox.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                            <local:InverseBoolToVisibility x:Key="InverseBoolToVis"/>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Right-click a chat to rename, pin or delete it -->
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Background="{DynamicResource CardBackground}"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     BorderBrush="{DynamicResource CardBorder}">
                                            <MenuItem Header="Rename" Click="RecentRename_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding PinMenuText}" Click="RecentPin_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Delete chat" Click="RecentDelete_Click"
                                                      Foreground="{DynamicResource ErrorText}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="13" Foreground="{DynamicResource ErrorText}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <DockPanel Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE718;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" ToolTip="Pinned"
                                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>
                                    <!-- Shown while renaming: Enter saves, Esc cancels. No event handlers in this template: they crash WPF here; the list handles them. -->
                                    <TextBox Text="{Binding Title, Mode=OneWay}" FontSize="13" Padding="4,1" Margin="-5,-2"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RecentEmpty" Text="Your questions will show up here."
                               FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Margin="12,4,8,0" VerticalAlignment="Top"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Drag to resize the left menu -->
        <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}" Margin="-3,0,0,0"
                      DragCompleted="SidebarSplitter_DragCompleted"/>

        <!-- Pages. All stay loaded so the AI sites keep their state when you switch pages. -->
        <Grid Grid.Column="2" Margin="2,6,6,6">
            <v:ChatView x:Name="ChatPage"/>
            <v:HistoryView x:Name="HistoryPage" Visibility="Collapsed"/>
            <v:CompareView x:Name="ComparePage" Visibility="Collapsed"/>
            <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
